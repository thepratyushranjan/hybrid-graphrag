# --- App ---
APP_NAME=graphrag
APP_ENV=dev
API_PORT=8000
UI_PORT=8501
# where the Streamlit UI finds the API (compose overrides it to http://api:8000)
API_URL=http://localhost:8000

# --- Qdrant ---
# localhost for running scripts on your machine; docker-compose overrides it to http://qdrant:6333 for the api container
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=knowledge_vectors

# --- Neo4j ---
# localhost for running scripts on your machine; docker-compose overrides it to bolt://neo4j:7687 for the api container
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please

# --- Provider keys (only the ones your chosen providers need) ---
OPENAI_API_KEY=
GEMINI_API_KEY=
# Ollama runs on your machine; the api container reaches it via host.docker.internal
OLLAMA_BASE_URL=http://localhost:11434

# --- LLM & generation (openai | gemini | ollama) ---
# LLM_PROVIDER / LLM_MODEL = the default: builds the knowledge graph at upload and answers when nothing is picked.
# Every provider below that has its key (or a running Ollama) can also be picked per question in the UI.
OLLAMA_MODEL=gemma4:latest
OPENAI_MODEL=gpt-4o-mini
GEMINI_MODEL=gemini-2.5-flash
LLM_PROVIDER=openai
LLM_MODEL=gpt-4o-mini
# Ollama example: LLM_PROVIDER=ollama, LLM_MODEL=gemma4:latest, and "thinking" per task:
#   LLM_REASONING_EFFORT=none        query analysis: fast, no thinking
#   ANSWER_REASONING_EFFORT=low      final answer: a little thinking for multi-step questions
#   EXTRACTION_REASONING_EFFORT=low  graph extraction at ingest: ~2x the facts, ~2x slower (runs in background)
# leave all three empty for gpt-4o-mini (it doesn't accept the parameter)
LLM_REASONING_EFFORT=
ANSWER_REASONING_EFFORT=
EXTRACTION_REASONING_EFFORT=

# --- Embeddings (huggingface | openai) ---
# huggingface: intfloat/multilingual-e5-small (384, 94 languages incl. Hindi)  <- default
#              BAAI/bge-small-en-v1.5 (384, English only)
# openai:      text-embedding-3-small (1536, multilingual)
EMBEDDING_PROVIDER=huggingface
EMBEDDING_MODEL=intfloat/multilingual-e5-small
EMBEDDING_DIM=384

# --- Reranker (multilingual HuggingFace cross-encoder, baked into the image) ---
RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1

# --- Ingestion ---
CHUNK_SIZE=500
CHUNK_OVERLAP=50
# OCR for images inside PDFs and scanned pages (Tesseract language codes, joined with +)
OCR_ENABLED=true
OCR_LANGUAGES=eng+hin
OCR_MIN_CONFIDENCE=60
# straighten tilted scans before OCR (searches +/- OCR_MAX_SKEW_DEGREES)
OCR_DESKEW=true
OCR_MAX_SKEW_DEGREES=10
# describe images without text (photos, charts) with a vision LLM; uses LLM_PROVIDER, VISION_MODEL defaults to LLM_MODEL
VISION_CAPTIONS_ENABLED=false
VISION_MODEL=

# --- Knowledge graph ---
# extract entities/relations with the LLM into Neo4j (needs a working LLM_PROVIDER)
GRAPH_ENABLED=true
EXTRACTION_MIN_CONFIDENCE=0.5
# link similar documents in Neo4j: (Document)-[:SIMILAR_TO {score}]->(Document)
# threshold depends on the embedding model (multilingual-e5: related ~0.93, unrelated ~0.87)
SIMILAR_DOCS_ENABLED=true
SIMILAR_DOCS_TOP_N=3
SIMILAR_DOCS_MIN_SCORE=0.90

# --- Retrieval ---
TOP_K=4
GRAPH_HOPS=2
VECTOR_CANDIDATES=20
MAX_FACTS=20
HUB_DEGREE_LIMIT=50
RERANK_ENABLED=true
CONTEXT_TOKEN_BUDGET=3000

# --- Answer generation ---
# skip the LLM ("not found") when no chunk or fact reaches this relevance (0-1)
MIN_EVIDENCE_SCORE=0.05

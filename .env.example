# --- App ---
APP_NAME=graphrag
APP_ENV=dev
API_PORT=8000

# --- Qdrant ---
# localhost for running scripts on your machine; docker-compose overrides it to http://qdrant:6333 for the api container
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=
COLLECTION_NAME=knowledge_vectors

# --- Neo4j ---
# localhost for running scripts on your machine; docker-compose overrides it to bolt://neo4j:7687 for the api container
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=change-me-please

# --- LLM (groq | openai | ollama) ---
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile
LLM_API_KEY=

# --- Embeddings ---
EMBEDDING_MODEL=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# --- Retrieval ---
TOP_K=4
GRAPH_HOPS=1
